; Removes the installed version of @PROJECT_TITLE@ before new files are copied, so updates replace it silently
; and the running application is closed. Versions 1.5 and older registered themselves under versioned
; uninstall keys (e.g. "@PROJECT_TITLE@ 1.5"), such installations are removed too, so no stale entries are
; left in the list of installed apps. Every installation is removed by its own uninstaller, so nothing is orphaned.

!include "FileFunc.nsh"

!define PREVIOUS_UNINSTALL_ROOT "Software\Microsoft\Windows\CurrentVersion\Uninstall"
!define PREVIOUS_KEY "@PROJECT_TITLE@"
!define PREVIOUS_LEGACY_KEY_PREFIX "@PROJECT_TITLE@ "
!define PREVIOUS_PUBLISHER "@PROJECT_DEVELOPER_TITLE@"

Function RemovePreviousInstalls
    Push $0 ; Subkey index
    Push $1 ; Subkey name
    Push $2 ; Temporary value
    Push $3 ; Uninstaller path
    Push $4 ; Installation directory

    StrCpy $0 0

    loop:
        EnumRegKey $1 HKLM "${PREVIOUS_UNINSTALL_ROOT}" $0
        StrCmp $1 "" done

        ; Current unversioned key or a versioned key of older versions
        StrCmp $1 "${PREVIOUS_KEY}" check_publisher
        StrLen $2 "${PREVIOUS_LEGACY_KEY_PREFIX}"
        StrCpy $2 $1 $2
        StrCmp $2 "${PREVIOUS_LEGACY_KEY_PREFIX}" check_publisher next

    check_publisher:
        ReadRegStr $2 HKLM "${PREVIOUS_UNINSTALL_ROOT}\$1" "Publisher"
        StrCmp $2 "${PREVIOUS_PUBLISHER}" 0 next

        ; Uninstall string is the quoted path to the uninstaller
        ReadRegStr $3 HKLM "${PREVIOUS_UNINSTALL_ROOT}\$1" "UninstallString"
        StrCpy $2 $3 1
        StrCmp $2 '"' 0 +2
            StrCpy $3 $3 -1 1

        IfFileExists "$3" 0 cleanup
            ${GetParent} "$3" $4
            DetailPrint "Removing previous installation: $1"

            ; "_?=" makes the uninstaller run in place, so ExecWait waits until it finishes
            ExecWait '"$3" /S _?=$4'

            ; Running in place, the uninstaller can't delete itself
            Delete "$3"
            RMDir "$4"

    cleanup:
        DeleteRegKey HKLM "${PREVIOUS_UNINSTALL_ROOT}\$1"
        DeleteRegKey HKLM "Software\${PREVIOUS_PUBLISHER}\$1"
        DeleteRegKey /ifempty HKLM "Software\${PREVIOUS_PUBLISHER}"

        ; The next subkey takes the index of the removed one, but skip the key if it couldn't be removed
        ReadRegStr $2 HKLM "${PREVIOUS_UNINSTALL_ROOT}\$1" "UninstallString"
        StrCmp $2 "" loop next

    next:
        IntOp $0 $0 + 1
        Goto loop

    done:
        ; Uninstallers may have removed the installation directory
        SetOutPath "$INSTDIR"

    Pop $4
    Pop $3
    Pop $2
    Pop $1
    Pop $0
FunctionEnd

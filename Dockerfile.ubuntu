# Ubuntu 22.04 is the oldest LTS that provides Qt 6.11.2 compatibility.
# Building here maximizes forward compatibility with newer distros.
FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

ENV QT_MIRROR=https://mirror.yandex.ru/mirrors/qt.io
ENV QT_ARCHIVE_PATH=/archive/qt/6.11/6.11.2/single/qt-everywhere-src-6.11.2.tar.xz
ENV QT_ARCHIVE_MD5SUM=669c1f3a41c37fdda389094882044d7a
ENV QT_PREFIX="/usr/local/qt"

# -----------------------------------------------------------------------------
# Stage: Base build tools
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    fakeroot \
    file \
    git \
    libssl-dev \
    ninja-build \
    patchelf \
    perl \
    python3 \
    python3-pip \
    && apt-get clean

# -----------------------------------------------------------------------------
# Stage: Qt GUI dependencies (X11 + Wayland + font rendering)
# -----------------------------------------------------------------------------
# These cover both classic XCB and modern Wayland backends.
# Additional GL/EGL/GBM libs are included for hardware-accelerated rendering.
RUN apt-get update && apt-get install -y \
    fontconfig \
    libdbus-1-dev \
    libegl1-mesa-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libgbm-dev \
    libgl1-mesa-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libice-dev \
    libsm-dev \
    libwayland-dev \
    libx11-dev \
    libx11-xcb-dev \
    libxcb-cursor-dev \
    libxcb-glx0-dev \
    libxcb-icccm4-dev \
    libxcb-image0-dev \
    libxcb-keysyms1-dev \
    libxcb-randr0-dev \
    libxcb-render-util0-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcb-shm0-dev \
    libxcb-sync-dev \
    libxcb-util-dev \
    libxcb-xfixes0-dev \
    libxcb-xinerama0-dev \
    libxcb-xkb-dev \
    libxcb1-dev \
    libxext-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    pkg-config \
    wayland-protocols \
    && apt-get clean

# Upgrade CMake to a version recent enough for Qt 6.11+
# (system cmake on Ubuntu 22.04 is too old)
RUN pip3 install --upgrade cmake

# -----------------------------------------------------------------------------
# Stage: Download Qt source tarball from a reliable mirror
# -----------------------------------------------------------------------------
WORKDIR /qt

RUN apt-get update && apt-get install -y wget xz-utils && \
    wget $QT_MIRROR/$QT_ARCHIVE_PATH --progress=dot:giga -O sources.tar.xz && \
    echo "$QT_ARCHIVE_MD5SUM sources.tar.xz" | md5sum -c - && \
    mkdir sources && \
    tar -xf sources.tar.xz -C sources --strip-components=1 \
        --checkpoint=1000 --checkpoint-action=dot && \
    rm sources.tar.xz

# -----------------------------------------------------------------------------
# Stage: Configure Qt (shadow build outside source tree)
# -----------------------------------------------------------------------------
WORKDIR /qt/build

# Configure with minimal set of modules to reduce build time.
# We keep only what is strictly necessary:
#   qtbase      – core + GUI + widgets
#   qtshadertools – required for Qt Quick / shader compilation
#   qtsvg       – SVG rendering support
#   qtimageformats – extra image formats (WebP, TIFF, etc.)
#   qtwayland   – Wayland platform plugin
#
# Most other modules are skipped to keep the image small and build fast.
# If you need additional modules, remove the corresponding `-skip` lines.
RUN ../sources/configure \
    -opensource \
    -confirm-license \
    -release \
    -no-icu \
    -xcb \
    \
    # Disable heavy / non‑essential modules
    -skip qt3d \
    -skip qt5compat \
    -skip qtactiveqt \
    -skip qtcanvaspainter \
    -skip qtcharts \
    -skip qtcoap \
    -skip qtconnectivity \
    -skip qtdatavis3d \
    -skip qtdeclarative \
    -skip qtdoc \
    -skip qtgraphs \
    -skip qtgrpc \
    -skip qthttpserver \
    -skip qtlanguageserver \
    -skip qtlocation \
    -skip qtlottie \
    -skip qtmqtt \
    -skip qtmultimedia \
    -skip qtnetworkauth \
    -skip qtopcua \
    -skip qtopenapi \
    -skip qtpositioning \
    -skip qtquick3d \
    -skip qtquick3dphysics \
    -skip qtquickeffectmaker \
    -skip qtquicktimeline \
    -skip qtremoteobjects \
    -skip qtscxml \
    -skip qtsensors \
    -skip qtserialbus \
    -skip qtserialport \
    -skip qtshadertools \
    -skip qtspeech \
    -skip qttasktree \
    -skip qttools \
    -skip qttranslations \
    -skip qtvirtualkeyboard \
    -skip qtwebchannel \
    -skip qtwebengine \
    -skip qtwebsockets \
    -skip qtwebview \
    \
    # Disable rarely‑used features to reduce binary size
    -no-feature-printer \
    -no-feature-pdf \
    -no-feature-sql \
    -no-feature-vulkan \
    \
    # Skip building non-essential categories
    -nomake examples \
    -nomake tests \
    \
    # Set install prefix
    -prefix $QT_PREFIX \
    -- \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=MinSizeRel \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON

# -----------------------------------------------------------------------------
# Stage: Build and install only the required modules
# -----------------------------------------------------------------------------
# We explicitly list targets we need – this is faster than building 'all'.
# After installation, the source and build directories are removed to save space.
RUN cmake --build . --target qtbase qtsvg qtimageformats qtwayland --parallel $(nproc) && \
    cmake --install . --strip && \
    cd / && rm -rf /qt

# Add Qt binaries to PATH for subsequent RUN commands (e.g., qmake, moc)
ENV PATH="$QT_PREFIX/bin:$PATH"
